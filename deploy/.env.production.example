# Copier sur le VPS : cp deploy/.env.production.example .env

# --- MJ gratuit : LM Studio sur le Mac + tunnel SSH (voir deploy/LMSTUDIO-VPS.md) ---
# API en network_mode: host → 127.0.0.1:1234 (tunnel SSH sur le VPS)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# --- MJ cloud (optionnel — uniquement si vous utilisez OpenAI/Anthropic) ---
# OPENAI_API_KEY=sk-votre-cle-openai

# --- Chemin public (Nginx) ---
NEXT_PUBLIC_BASE_PATH=/rpg-cr

# --- Ports locaux (127.0.0.1 uniquement — pas exposés sur Internet) ---
WEB_PORT=3010
API_PORT=4010

# --- Comptes joueurs (Google OAuth) ---
# URI de redirection Google : https://vps-e09ed6db.vps.ovh.net/rpg-cr/api/auth/callback/google
AUTH_SECRET=
AUTH_URL=https://vps-e09ed6db.vps.ovh.net/rpg-cr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_INTERNAL_SECRET=
API_INTERNAL_URL=http://127.0.0.1:4010

# URL publique (optionnel — pour SSR / liens absolus)
# NEXT_PUBLIC_APP_URL=https://vps-e09ed6db.vps.ovh.net/rpg-cr
