# Copier sur le VPS : cp deploy/.env.production.example .env

# --- MJ gratuit : LM Studio sur le Mac + tunnel SSH (voir deploy/LMSTUDIO-VPS.md) ---
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# --- MJ cloud (optionnel — uniquement si vous utilisez OpenAI/Anthropic) ---
# OPENAI_API_KEY=sk-votre-cle-openai

# --- Chemin public (Nginx) ---
NEXT_PUBLIC_BASE_PATH=/rpg-cr

# --- Ports locaux (127.0.0.1 uniquement — pas exposés sur Internet) ---
WEB_PORT=3010
API_PORT=4010

# URL publique (optionnel — pour SSR / liens absolus)
# NEXT_PUBLIC_APP_URL=https://vps-e09ed6db.vps.ovh.net/rpg-cr
