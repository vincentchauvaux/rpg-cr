# Copier sur le VPS : cp deploy/.env.production.example .env

# --- MJ gratuit (local OpenAI-compatible) ---
# Option A — Ollama sur le VPS (sans Mac) : deploy/OLLAMA-VPS.md
# LM_STUDIO_BASE_URL=http://127.0.0.1:11434/v1
# Option B — LM Studio Mac + tunnel SSH : deploy/LMSTUDIO-VPS.md
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_BASE_URL=http://127.0.0.1:11434/v1

# --- MJ cloud (optionnel) ---
# OPENAI_API_KEY=sk-votre-cle-openai
# OPENROUTER_API_KEY=sk-or-votre-cle
# OPENROUTER_HTTP_REFERER=https://vps-e09ed6db.vps.ovh.net/rpg-cr
# GROQ_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=openrouter
# AI_MODEL=google/gemini-3.8-flash
# AI_FALLBACK_PROVIDER=groq
# Prod VPS : Gemini Google direct est souvent refusé (IP datacenter).
# OpenRouter sert le même Flash. Groq en secours.

# --- Chemin public (Nginx) ---
NEXT_PUBLIC_BASE_PATH=/rpg-cr

# --- Ports locaux (127.0.0.1 uniquement — pas exposés sur Internet) ---
WEB_PORT=3010
API_PORT=4010

# --- Comptes joueurs (Google OAuth) ---
# URI de redirection Google : https://vps-e09ed6db.vps.ovh.net/rpg-cr/api/auth/callback/google
# (repli legacy : https://vps-e09ed6db.vps.ovh.net/api/auth/callback/google)
AUTH_SECRET=
# Origine publique HTTPS — sans /rpg-cr (Auth.js ajoute basePath /rpg-cr/api/auth)
AUTH_URL=https://vps-e09ed6db.vps.ovh.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_INTERNAL_SECRET=
API_INTERNAL_URL=http://127.0.0.1:4010

# --- Sécurité API ---
# Origines CORS autorisées (virgules). Défaut prod = AUTH_URL / NEXT_PUBLIC_APP_URL
# CORS_ORIGINS=https://vps-e09ed6db.vps.ovh.net
# RATE_LIMIT_MAX=240

# --- Mentions légales / RGPD (pages /mentions-legales, /confidentialite, /cgu) ---
# LEGAL_SITE_NAME=RPG-CR
# LEGAL_PUBLISHER_NAME=
# LEGAL_PUBLISHER_ADDRESS=
# LEGAL_PUBLISHER_STATUS=
# LEGAL_CONTACT_EMAIL=
# LEGAL_HOST_NAME=OVH SAS
# LEGAL_HOST_ADDRESS=2 rue Kellermann, 59100 Roubaix, France

# URL publique (optionnel — pour SSR / liens absolus)
# NEXT_PUBLIC_APP_URL=https://vps-e09ed6db.vps.ovh.net/rpg-cr
