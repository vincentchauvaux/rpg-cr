OPENAI_API_KEY=
# Clé OpenRouter (sk-or-…) — chaîne automatique serveur (pas un choix joueur)
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=https://vps-e09ed6db.vps.ovh.net/rpg-cr

# --- MJ automatique (clés serveur uniquement, jamais NEXT_PUBLIC_*) ---
# GROQ_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.8-flash
# AI_FALLBACK_PROVIDER=groq
# Le salon ne choisit plus le moteur. Chaîne : AI_PROVIDER → Groq → OpenRouter → Gemini → Ollama.
# Groq avant Gemini : l'API Gemini refuse souvent les IP datacenter OVH (503).
# Local Mac : Gemini Google direct. Prod VPS : souvent OpenRouter google/gemini-3.8-flash
# (l’API Gemini refuse souvent les IP datacenter OVH).
# Journal des appels LLM (JSONL, sans prompts ni clés) — défaut à côté de la DB.
# LLM_LOG_PATH=

# URL OpenAI-compatible Ollama / LM Studio (dernier secours serveur)
LM_STUDIO_BASE_URL=http://127.0.0.1:11434/v1

# --- API (serveur Node) ---
HOST=0.0.0.0
PORT=4000
DATABASE_PATH=./apps/api/data/rpg-cr.db

# Moteur Rust (fiche JSON, Acte I, épreuves) — 127.0.0.1:4020
# RPG_CR_ENGINE_URL=http://127.0.0.1:4020
# RPG_CR_ENGINE_BIN=./target/release/rpg-cr-engine
# RPG_CR_ENGINE_PORT=4020

# --- Front (Next.js) ---
# En navigateur, l'API/WS utilisent automatiquement le MÊME hostname que la page
# (ex. page http://192.168.0.210:3000 → API http://192.168.0.210:4000).
# Ports modifiables si besoin :
NEXT_PUBLIC_API_PORT=4000
NEXT_PUBLIC_WS_PORT=4000
NEXT_PUBLIC_WEB_PORT=3000

# --- Production VPS Nginx (/rpg-cr) — voir deploy/.env.production.example ---
# NEXT_PUBLIC_BASE_PATH=/rpg-cr
# WEB_PORT=3010
# API_PORT=4010
# OPENAI_API_KEY=sk-...

# --- Comptes joueurs (Google OAuth) — voir agent.md ---
# AUTH_SECRET=          # openssl rand -base64 32
# AUTH_URL=https://vps-e09ed6db.vps.ovh.net/rpg-cr
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_INTERNAL_SECRET= # même secret API + web (sync profil)
# API_INTERNAL_URL=http://127.0.0.1:4010

# --- Sécurité / légal (prod) ---
# CORS_ORIGINS=https://vps-e09ed6db.vps.ovh.net
# LEGAL_PUBLISHER_NAME=
# LEGAL_PUBLISHER_ADDRESS=
# LEGAL_CONTACT_EMAIL=contact@votre-domaine.fr

# Optionnel : uniquement pour SSR / docker avec domaine fixe (sinon laisser commenté)
# NEXT_PUBLIC_API_URL=http://192.168.0.210:4000
# NEXT_PUBLIC_WS_URL=ws://192.168.0.210:4000
# NEXT_PUBLIC_APP_URL=http://192.168.0.210:3000
