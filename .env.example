OPENAI_API_KEY=
# URL OpenAI-compatible LM Studio (fallback serveur ou provider lmstudio)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Le model id (ex. google/gemma-3-4b) se configure dans l'UI god mode, pas ici

# --- API (serveur Node) ---
HOST=0.0.0.0
PORT=4000
DATABASE_PATH=./apps/api/data/rpg-cr.db

# --- Front (Next.js) ---
# En navigateur, l'API/WS utilisent automatiquement le MÊME hostname que la page
# (ex. page http://192.168.0.210:3000 → API http://192.168.0.210:4000).
# Ports modifiables si besoin :
NEXT_PUBLIC_API_PORT=4000
NEXT_PUBLIC_WS_PORT=4000
NEXT_PUBLIC_WEB_PORT=3000

# --- Production VPS Nginx (/rpg-cr) — voir deploy/.env.production.example ---
# NEXT_PUBLIC_BASE_PATH=/rpg-cr
# WEB_PORT=3010
# API_PORT=4010
# OPENAI_API_KEY=sk-...

# --- Comptes joueurs (Google OAuth) — voir agent.md ---
# AUTH_SECRET=          # openssl rand -base64 32
# AUTH_URL=https://vps-e09ed6db.vps.ovh.net/rpg-cr
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_INTERNAL_SECRET= # même secret API + web (sync profil)
# API_INTERNAL_URL=http://127.0.0.1:4010

# Optionnel : uniquement pour SSR / docker avec domaine fixe (sinon laisser commenté)
# NEXT_PUBLIC_API_URL=http://192.168.0.210:4000
# NEXT_PUBLIC_WS_URL=ws://192.168.0.210:4000
# NEXT_PUBLIC_APP_URL=http://192.168.0.210:3000
